# Required for Vercel/remote updates only. Local npm start scrapes directly.
STANDINGS_PROVIDER_URL=
STANDINGS_PROVIDER_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set a strong token to restrict manual updates and enable Drive uploads.
EDITOR_TOKEN=
# Optional Google Apps Script /exec endpoint and matching Script Property secret
DRIVE_API_URL=
DRIVE_SHARED_SECRET=
# Worker only: enable only when you have source access permission
FLASHSCORE_AUTHORIZED=false
PORT=8000
